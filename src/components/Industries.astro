---
// "Industries We Serve": each sector drawn as its typical load on a small wooden pallet, linking to the
// pallets that sector buys. Desktop and tablets: a row of tiles. Phones: a "forklift picker", one big
// stage and eight sector buttons; changing sector lifts the old load off and drops the new one on.
// Home and about pages.
import { categoryUrl } from '../lib/catalog';


// Outline of a spur gear with `n` flat-topped teeth, as an SVG path.
function gear(cx: number, cy: number, outer: number, inner: number, n: number) {
  const pts: string[] = [];
  for (let i = 0; i < n; i++) {
    const a = (i / n) * 2 * Math.PI;
    const s = Math.PI / n;
    for (const [r, da] of [[inner, -s * 0.55], [outer, -s * 0.3], [outer, s * 0.3], [inner, s * 0.55]] as const) {
      pts.push(`${(cx + r * Math.cos(a + da)).toFixed(1)} ${(cy + r * Math.sin(a + da)).toFixed(1)}`);
    }
  }
  return `M${pts.join('L')}Z`;
}

// Goods are drawn on a 120 × 100 canvas; the pallet below them is shared (deck at y = 78).
