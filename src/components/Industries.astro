const pallet = `<path d="M8 78h104v6H8z"/><path d="M12 84h12v8H12zM54 84h12v8H54zM96 84h12v8H96z"/><path d="M8 92h104v5H8z"/><path class="grain" d="M18 81h22M70 81h28M20 94.5h30M66 94.5h34"/>`;
---

<ul class="industries-strip">
  {
    industries.map((ind) => (
      <li>
        <a class="ind-tile" href={ind.link[1]} title={ind.text}>
          <span class="ind-art">
            <svg viewBox="0 0 120 100" aria-hidden="true">
              <g class="ind-goods" set:html={ind.goods} />
              <g class="ind-pallet" set:html={pallet} />
            </svg>
          </span>
          <span class="ind-name">{ind.name}</span>
          <span class="ind-link">{ind.link[0]} <span aria-hidden="true">→</span></span>
        </a>
      </li>
    ))
  }
</ul>

<div class="ind-picker" data-ind-picker>
  <div class="ind-stage">
    <svg class="ind-stage-art" viewBox="0 0 120 100" aria-hidden="true">
      {industries.map((ind, i) => <g class={`ind-goods ind-load${i === 0 ? ' is-on' : ''}`} set:html={ind.goods} />)}
      <g class="ind-pallet" set:html={pallet} />
    </svg>
    <div class="ind-infos">
    {
      industries.map((ind, i) => (
        <div class="ind-info" hidden={i !== 0} aria-live="polite">
          <p class="ind-info-name">{ind.name}</p>
          <p class="ind-info-text">{ind.text}</p>
          <a href={ind.link[1]}>{ind.link[0]} <span aria-hidden="true">→</span></a>
        </div>
      ))
    }
    </div>
  </div>
  <div class="ind-chips" role="group" aria-label="Choose an industry">
    {
      industries.map((ind, i) => (
        <button type="button" class="ind-chip" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={ind.name}>
          <svg viewBox="0 0 120 100" aria-hidden="true">
            <g class="ind-goods" set:html={ind.goods} />
            <g class="ind-pallet" set:html={pallet} />
          </svg>
          <span>{ind.short}</span>
        </button>
      ))
    }
  </div>
</div>

<script>
  // Phones: the forklift picker. A tap shows that sector; until the visitor taps, it moves on by itself
  // every few seconds while it is on screen (not at all with reduced motion).
  document.querySelectorAll<HTMLElement>('[data-ind-picker]').forEach((picker) => {
    const loads = [...picker.querySelectorAll<SVGGElement>('.ind-load')];
    const infos = [...picker.querySelectorAll<HTMLElement>('.ind-info')];
    const chips = [...picker.querySelectorAll<HTMLButtonElement>('.ind-chip')];
    let current = 0;
    let timer: number | undefined;
    const show = (i: number) => {
      if (i === current) return;
      loads[current].classList.remove('is-on');
      loads[i].classList.add('is-on');
      infos[current].hidden = true;
      infos[i].hidden = false;
      chips[current].setAttribute('aria-pressed', 'false');
      chips[i].setAttribute('aria-pressed', 'true');
      current = i;
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    chips.forEach((chip, i) =>
      chip.addEventListener('click', () => {
        picker.dataset.touched = '1';
        stop();
        show(i);
      }),
    );
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && timer === undefined && !picker.dataset.touched) timer = window.setInterval(() => show((current + 1) % loads.length), 3200);
        else if (!e.isIntersecting) stop();
      },
      { threshold: 0.5 },
    ).observe(picker);
  });
</script>
