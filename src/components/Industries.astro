    link: ['Pinewood pallets', categoryUrl('pinewood-pallets')],
    goods: `<rect x="26" y="38" width="68" height="40" rx="2"/><path d="M26 51h68M26 64h68"/><path class="soft" d="M30 42l60 32M90 42L30 74"/><rect x="26" y="38" width="68" height="40" rx="2" class="line"/>`,
  },
  {
    name: 'Logistics & Warehousing',
    short: 'Logistics',
    text: 'Standard footprints that fit racking, trucks, containers and hand pallet trucks.',
    link: ['Euro-size pallets', categoryUrl('euro-pallets')],
    goods: `<rect x="22" y="56" width="36" height="22" rx="1.5"/><rect x="62" y="56" width="36" height="22" rx="1.5"/><rect x="34" y="32" width="36" height="24" rx="1.5"/><path class="tape" d="M40 56v22M80 56v22M52 32v24"/><path class="line" d="M78 22h18m-6-6 6 6-6 6"/>`,
  },
  {
    name: 'FMCG',
    short: 'FMCG',
    text: 'Light, consistent pallets for high-volume cartons, cases and bottled goods.',
    link: ['GMA pallets', categoryUrl('gma-pallets')],
    goods: `${[22, 38, 54, 70, 86]
      .map((x) => `<path d="M${x + 4} 46v-6h4v6c4 2 5 4 5 8v24h-14v-24c0-4 1-6 5-8z"/><path class="tape" d="M${x + 1} 60h12"/>`)
      .join('')}`,
  },
  {
    name: 'Pharmaceuticals',
    short: 'Pharma',
    text: 'Clean, heat-treated pallets for packed medicines and regulated export consignments.',
    link: ['Euro-size pallets', categoryUrl('euro-pallets')],
    goods: `<rect x="24" y="48" width="34" height="30" rx="1.5"/><rect x="62" y="48" width="34" height="30" rx="1.5"/><path class="accent" d="M41 56v14M34 63h14M79 56v14M72 63h14"/><g transform="rotate(-30 60 28)"><rect x="46" y="22" width="28" height="12" rx="6"/><path class="tape" d="M60 22v12"/></g>`,
  },
  {
    name: 'Chemicals & Polymers',
    short: 'Chemicals',
    text: 'CP1 to CP9 pallets sized for drums, sacks, octabins and IBCs.',
    link: ['CP-type pallets', categoryUrl('cp-pallets')],
    goods: `${[24, 62]
      .map((x) => `<path d="M${x} 34v40c0 3 6 4 17 4s17-1 17-4V34"/><ellipse cx="${x + 17}" cy="34" rx="17" ry="4"/><path class="tape" d="M${x} 48c0 3 6 4 17 4s17-1 17-4M${x} 62c0 3 6 4 17 4s17-1 17-4"/>`)
      .join('')}`,
  },
  {
    name: 'Engineering & Heavy Industries',
    short: 'Heavy industry',
    text: 'Hardwood pallets and skids for machinery, castings and heavy fabricated parts.',
    link: ['Hardwood pallets', categoryUrl('hardwood-pallets')],
    goods: `<path d="${gear(60, 52, 25, 20, 10)}"/><circle class="accent-fill" cx="60" cy="52" r="8"/>`,
  },
  {
    name: 'Automotive',
    short: 'Auto',
    text: 'Pallets with stackable collars for components, spares and returnable packaging.',
    link: ['Pallet collars', categoryUrl('pallet-collars')],
    // a small car (side view, facing right) parked on the pallet
    goods: `<path d="M16 66v-8q0-5 5-6l14-3 12-12q3-3 7-3h20q4 0 7 3l12 12h7q6 0 6 6v11q0 2-2 2H18q-2 0-2-2z"/>` +
      `<path class="accent-fill" d="M42 47l8.5-8.5H61V47zM65 38.5h12.5L86 47H65z"/>` +
      `<path class="tape" d="M63 49v17M70 54h5M101 55h3"/>` +
      [36, 86].map((x) => `<circle cx="${x}" cy="69" r="9"/><circle class="accent-fill" cx="${x}" cy="69" r="3.5"/>`).join(''),
  },
  {
    name: 'Exporters & Importers',
    short: 'Export',
    text: 'ISPM-15 heat treated and stamped IN-081 HT, accepted at customs worldwide.',
    link: ['ISPM-15 heat treatment', '/quality-certifications/'],
    goods: `<rect x="30" y="54" width="60" height="24" rx="1.5"/><path class="tape" d="M60 54v24"/><circle cx="60" cy="31" r="17"/><path class="tape" d="M43 31h34M60 14c-6 5-8 11-8 17s2 12 8 17c6-5 8-11 8-17s-2-12-8-17z"/>`,
