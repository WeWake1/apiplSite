---
// Old-site product card (home page "Our Product Range" style)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  image: { src: ImageMetadata; alt: string };
  text?: string;
  line?: string; // short line, shown instead of the text in the home page's phone rows
  delay?: number;
  heading?: 'h2' | 'h3';
}
const { href, title, image, text, line, delay = 0, heading = 'h3' } = Astro.props;
const H = heading;
---

<a href={href} class="product-card">
  <div class="product-card-image">
    <Image src={image.src} alt={image.alt} widths={[400, 600, 800]} sizes="(max-width: 768px) 90vw, 400px" loading="lazy" />
  </div>
  <H>{title}</H>
  {line && <p class="product-card-line">{line}</p>}
  {text && <p class="product-card-text">{text}</p>}
  {line && <span class="product-card-arrow" aria-hidden="true">→</span>}
</a>
