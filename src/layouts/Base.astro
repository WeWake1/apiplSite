---
// Page shell in the original Ambica Patterns design: header, footer, AOS scroll animations.
// Libraries are bundled locally instead of loaded from CDNs. (No smooth scrolling: native scroll by request.)
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import 'aos/dist/aos.css';
import '../styles/legacy.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Fa from '../components/Fa.astro';
import JsonLd from '../components/JsonLd.astro';
import View3D from '../components/View3D.astro';
import { site, fullAddress, whatsappLink } from '../data/site';
import { mainImage, productBySlug } from '../lib/catalog';
import itcAnna from '../fonts/itc-anna.otf?url';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  active?: 'home' | 'about' | 'products' | 'contact' | '';
  mainClass?: string;
  // Call to action shown in the footer under the tagline; pages override the wording, false hides it.
  cta?: { title: string; text: string; href?: string; label?: string } | false;
  // Message pre-typed in the floating WhatsApp button (product pages name their pallet)
  whatsappText?: string;
}
const defaultCta = {
  title: 'Ready to Partner With Us?',
  text: "Let's discuss how we can provide the perfect pallet solutions for your business needs.",
};
const { title, description, image, type = 'website', noindex = false, schema = [], active = '', mainClass, cta = defaultCta, whatsappText } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title.includes('Ambica') || title.length > 46 ? title : `${title} | Ambica Patterns`;
const og = await getImage({ src: image ?? mainImage(productBySlug['euro-pallet-1200x800']).src, width: 1200, height: 900, format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, site.url).href;
const year = new Date().getFullYear();
const guides = (await getCollection('guides')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const social = Object.entries(site.social).filter(([, url]) => url);
const nav = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/about/', label: 'About Us', key: 'about' },
  { href: '/products/', label: 'Products', key: 'products' },
  { href: '/contact/', label: 'Contact Us', key: 'contact' },
];
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.legalName,
  alternateName: site.name,
  description: site.description,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  image: ogUrl,
  telephone: site.phones[0].tel,
  email: site.email,
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapsUrl,
  openingHours: site.hours.schema,
  areaServed: ['IN', 'Worldwide'],
  sameAs: social.map(([, u]) => u),
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content={site.legalName} />
    <meta name="theme-color" content="#0056b3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={itcAnna} as="font" type="font/otf" crossorigin />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="900" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="geo.region" content="IN-KA" />
    <meta name="geo.placename" content="Bengaluru" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    <JsonLd data={business} />
    {schema.map((s) => <JsonLd data={s} />)}
    {
      site.ga4Id && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`} />
          <script is:inline define:vars={{ id: site.ga4Id }}>
            window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', id);
          </script>
        </>
      )
    }
    <noscript><style>[data-aos]{opacity:1!important;transform:none!important}</style></noscript>
  </head>
  <body id="top">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header>
      <div class="logo">
        <a href="/" aria-label="Ambica Patterns India Pvt Ltd, home">Ambica Patterns<span class="logo-rest"> India Pvt Ltd</span></a>
      </div>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} class={active === n.key ? 'active' : undefined} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
      </nav>
      <button class="hamburger-menu" aria-label="Open Navigation Menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>

    <main id="main-content" class={mainClass}>
      <slot />
    </main>

    <footer class="site-footer-new">
      <div class="footer-main">
        <div class="footer-heading">
          <h2>{site.tagline}</h2>
          {
            cta && (
              <div class="footer-cta">
                <div>
                  <h2>{cta.title}</h2>
                  <p>{cta.text}</p>
                </div>
                <a href={cta.href ?? '/contact/#quote'} class="cta-button">{cta.label ?? 'Get in Touch'} <Fa name="arrow-right" /></a>
              </div>
            )
          }
        </div>
        <div class="footer-grid">
          <div class="footer-column">
            <h3>Contact Us</h3>
            <p><Fa name="location-dot" /><a href={site.mapsUrl} target="_blank" rel="noopener">No.6/7, Hesarghatta Main Road,<br />Near Railway Station, Chikkabanavara<br />Bangalore -560090, Karnataka, India</a></p>
            <p><Fa name="phone" /> <a href={`tel:${site.phones[0].tel}`}>{site.phones[0].display}</a><br /><a href={`tel:${site.phones[1].tel}`}>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; {site.phones[1].display}</a></p>
            <p><Fa name="envelope" /> <a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>
          <div class="footer-column">
            <h3><a href="/quality-certifications/">Licenses</a></h3>
            <div class="licenses-container">
              {site.certifications.map((c) => <a class="license-badge" href="/quality-certifications/">{c.badge}{c.sub && <small>{c.sub}</small>}</a>)}
            </div>
            <h3 class="footer-guides"><a href="/guides/">Buyer Guides</a></h3>
            <ul class="footer-guide-list">
              {guides.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}
            </ul>
          </div>
        </div>
      </div>
      <div class="footer-bottom-new">
        <div class="copyright-text">© {year} {site.legalName}. All Rights Reserved.</div>
        <div class="footer-bottom-right">
          {
            social.length > 0 && (
              <div class="social-icons-bottom">
                {social.map(([n, url]) => (
                  <a href={url} aria-label={n} target="_blank" rel="noopener">
                    <Fa name={n === 'facebook' ? 'facebook-f' : n} set="brands" />
                  </a>
                ))}
              </div>
            )
          }
          <a href="#top" class="back-to-top" id="back-to-top-button">Back to Top <Fa name="arrow-up" /></a>
        </div>
      </div>
    </footer>

    <a class="wa-float" href={whatsappLink(whatsappText)} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
      <Fa name="whatsapp" set="brands" />
    </a>

    <View3D />
    <script>
      import AOS from 'aos';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- Hamburger menu
      const hamburger = document.querySelector<HTMLButtonElement>('.hamburger-menu');
      const nav = document.querySelector('header nav');
      hamburger?.addEventListener('click', () => {
        const open = !nav?.classList.contains('is-open');
        nav?.classList.toggle('is-open', open);
        hamburger.classList.toggle('is-active', open);
        hamburger.setAttribute('aria-expanded', String(open));
        hamburger.setAttribute('aria-label', open ? 'Close Navigation Menu' : 'Open Navigation Menu');
        document.body.classList.toggle('body-no-scroll', open);
      });

      // --- On-scroll animations (headings and images only). html.aos-ready switches the hidden start state on,
      // so content is never left invisible if this script fails.
      try {
        document.documentElement.classList.add('aos-ready');
        // quick and only once: just headings and images carry data-aos (owner found the slow fades tiring)
        AOS.init({ duration: 400, easing: 'ease-out', once: true, offset: 40, disable: reduce });
        window.addEventListener('load', () => AOS.refresh());
      } catch {
        document.documentElement.classList.remove('aos-ready');
      }

      // --- Back to top
      document.getElementById('back-to-top-button')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });

      // --- Taps: a rounded pressed state instead of the browser's square flash (legacy.css, "Taps"). Shown
      // after a moment, or at once on a quick tap, and dropped as soon as the touch turns into a scroll.
      const TAPPABLE = 'a, button, summary, [role="button"], [role="tab"]';
      let pressed: Element | null = null;
      let pressTimer = 0;
      let pressX = 0;
      let pressY = 0;
      const unpress = () => {
        window.clearTimeout(pressTimer);
        pressTimer = 0;
        pressed?.classList.remove('is-pressed');
        pressed = null;
      };
      document.addEventListener(
        'pointerdown',
        (e) => {
          unpress();
          if (e.pointerType === 'mouse' || !(e.target instanceof Element)) return;
          const el = e.target.closest(TAPPABLE);
          if (!el) return;
          pressed = el;
          pressX = e.clientX;
          pressY = e.clientY;
          pressTimer = window.setTimeout(() => {
            pressTimer = 0;
            el.classList.add('is-pressed');
          }, 80);
        },
        { passive: true },
      );
      document.addEventListener('pointermove', (e) => pressed && Math.hypot(e.clientX - pressX, e.clientY - pressY) > 10 && unpress(), { passive: true });
      document.addEventListener('pointercancel', unpress);
      window.addEventListener('scroll', () => pressed && unpress(), { passive: true });
      window.addEventListener('pageshow', unpress);
      document.addEventListener('pointerup', () => {
        const el = pressed;
        if (!el) return;
        window.clearTimeout(pressTimer);
        pressTimer = 0;
        el.classList.add('is-pressed');
        window.setTimeout(() => {
          el.classList.remove('is-pressed');
          if (pressed === el) pressed = null;
        }, 180);
      });
    </script>
  </body>
</html>
