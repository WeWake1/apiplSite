---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Fa from '../components/Fa.astro';
import Industries from '../components/Industries.astro';
import { categories, categoryUrl, mainImage, productBySlug, products, productsIn } from '../lib/catalog';
import { site, yearsInBusiness } from '../data/site';
import imgJourney from '../assets/photos/planed-boards.jpg';
import imgQuality from '../assets/photos/timber-cutting-saw.jpg';

const commitments = [
  'On-time delivery',
  'Consistent quality, batch after batch',
  'Fair, competitive prices',
  'Long-term supply partnerships',
  'Less waste in cutting',
  'PEFC / FSC timber on request',
];

// One line per family for the "What We Do" index
const oneLiners: Record<string, string> = {
  'euro-pallets': '1200 × 800 and 1200 × 1000, 4-way, chamfered corners',
  'cp-pallets': 'CP1 to CP9 for drums, sacks, octabins and IBCs',
  'pinewood-pallets': 'Block, stringer and skid pallets in popular sizes',
  'hardwood-pallets': 'Heavy-duty pallets and skids for machinery and metal',
  'gma-pallets': '48 × 40 inch pallets for shipments to the USA and Canada',
  'pallet-collars': 'Hinged collars that turn a pallet into a stackable crate',
};
---

<Base
  title={`About Us: ${yearsInBusiness}+ Years of Pallet Manufacturing in Bengaluru`}
  description={`Ambica Patterns India Pvt Ltd has manufactured wooden pallets in Bengaluru since ${site.founded}: Euro-size, CP-type, GMA, pinewood and hardwood pallets. ISPM-15 ${site.ippc}, ISO 9001, PEFC / FSC.`}
  image={imgJourney}
  active="about"
>
  <section class="about-hero">
    <h1>About Ambica Patterns</h1>
    <p class="tagline">High-quality wooden pallets made in Bengaluru since {site.founded}, for customers across India and international markets.</p>
  </section>

  <section class="stats-section">
    <div class="stat-item"><span class="stat-number">{yearsInBusiness}+</span><span class="stat-label">Years Experience</span></div>
    <div class="stat-item"><span class="stat-number">1000+</span><span class="stat-label">Happy Clients</span></div>
    <div class="stat-item"><span class="stat-number">{products.length}</span><span class="stat-label">Pallet Models</span></div>
    <div class="stat-item"><span class="stat-number">ISPM-15</span><span class="stat-label">{site.ippc} Registered</span></div>
  </section>

  <section class="about-section">
    <div class="about-two-column">
      <div class="about-text">
        <h2 data-aos="fade-up">Our Journey</h2>
        <p>Ambica Patterns India Pvt Ltd started making wooden pallets in {site.founded} in a small workshop in north Bengaluru, and has grown into a dependable name in the trade.</p>
        <p>Over the years we have expanded our capabilities, registered our heat-treatment facility under ISPM-15, certified our quality system to ISO 9001 and added PEFC / FSC certified timber for customers who need it.</p>
      </div>
      <div class="about-image">
        <Image src={imgJourney} alt="Planed pallet boards at the Ambica Patterns workshop" widths={[480, 720, 960]} sizes="(max-width: 768px) 90vw, 45vw" loading="lazy" />
      </div>
    </div>
  </section>

  <div class="divider"><hr /></div>

  <section class="about-section">
    <h2 data-aos="fade-up">What We Do</h2>
    <p>We manufacture all types of wooden pallets, built to standard sizes or to the client's own specification, for strength, safety and efficiency in storage, handling and transport.</p>
    <ol class="range-index">
      {
        categories.map((c, i) => {
          const n = productsIn(c.slug).length;
          return (
            <li>
              <a href={categoryUrl(c.slug)}>
                <span class="ri-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="ri-text">
                  <span class="ri-name">{c.name}</span>
                  <span class="ri-line">{oneLiners[c.slug]}</span>
                </span>
                <span class="ri-count">{n} {n === 1 ? 'model' : 'models'}</span>
                <Image class="ri-img" src={mainImage(productBySlug[c.heroProduct]).src} alt="" widths={[160, 240]} sizes="120px" loading="lazy" />
                <span class="ri-arrow" aria-hidden="true"><Fa name="arrow-right" /></span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  <div class="divider"><hr /></div>

  <section class="about-section">
    <div class="about-two-column reverse">
      <div class="about-text">
        <h2 data-aos="fade-up">Quality &amp; Standards</h2>
        <p>Quality comes first: our production follows documented ISO 9001 checks, so every batch is consistent with the one before.</p>
        <p>Export pallets are heat treated in our registered ISPM-15 facility and stamped with the IPPC mark "{site.ippc} HT", so they are accepted by customs in every country that follows the standard. Euro-size, CP-type and GMA pallets are built to the published dimensions and board layouts.</p>
        <p>With our own machinery and a skilled team, we handle bulk orders and custom sizes. Timber is checked when it arrives, and every pallet is checked again before dispatch. <a href="/quality-certifications/">Read about our quality checks</a>.</p>
      </div>
      <div class="about-image">
        <Image src={imgQuality} alt="Cutting pallet boards to size at Ambica Patterns" widths={[480, 720, 960]} sizes="(max-width: 768px) 90vw, 45vw" loading="lazy" />
      </div>
    </div>
  </section>

  <div class="divider"><hr /></div>

  <section class="about-section">
    <h2 data-aos="fade-up">Industries We Serve</h2>
    <p>We cater to a wide range of industries, providing pallet solutions that meet the specific requirements of each sector.</p>
    <Industries />
  </section>

  <div class="divider"><hr /></div>

  <section class="about-section">
    <h2 data-aos="fade-up">Our Commitment</h2>
    <div class="commit">
      <p class="commit-text">We buy timber from responsible sources, can supply <em>PEFC / FSC certified timber</em> on request, and plan our cutting so little goes to waste.</p>
      <ul class="commit-list">
        {commitments.map((c) => <li><span class="commit-tick" aria-hidden="true"><Fa name="check" /></span>{c}</li>)}
      </ul>
    </div>
  </section>

  <div class="divider"><hr /></div>

  <section class="about-section">
    <h2 data-aos="fade-up">Vision &amp; Mission</h2>
    <div class="vm-statements">
      <div class="vm-row">
        <span class="vm-label">Our Vision</span>
        <p class="vm-text">To be the pallet supplier India's manufacturers and exporters rely on, known for <em>quality, reliability and new ideas</em>.</p>
      </div>
      <div class="vm-row">
        <span class="vm-label">Our Mission</span>
        <p class="vm-text">To make pallets that <em>meet international standards</em>, priced fairly and delivered when promised.</p>
      </div>
    </div>
  </section>
</Base>
