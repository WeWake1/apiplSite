---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Faq from '../components/Faq.astro';
import Fa from '../components/Fa.astro';
import Industries from '../components/Industries.astro';
import HeroBuild from '../components/HeroBuild.astro';
import { categories, categoryUrl, mainImage, productBySlug, products } from '../lib/catalog';
import { site, yearsInBusiness } from '../data/site';

import imgBlocks from '../assets/photos/cut-timber-blocks.jpg';
import g1 from '../assets/photos/timber-bundles-yard.jpg';
import g2 from '../assets/photos/timber-bundle.jpg';
import g3 from '../assets/photos/timber-cutting-saw.jpg';
import g4 from '../assets/photos/timber-logs-yard.jpg';
import g5 from '../assets/photos/sawn-timber-stack.jpg';
import g6 from '../assets/photos/forklift-loading-pallets.jpg';
import g7 from '../assets/photos/factory-euro-pallet.jpg';

const heroProduct = productBySlug['euro-pallet-1200x800'];
const hero = mainImage(heroProduct);
const gallery = [
  [g1, 'Bundles of sawn softwood timber in the Ambica Patterns yard'],
  [g2, 'Wrapped bundle of timber ready for pallet production'],
  [g3, 'Circular saw cutting pallet boards to size'],
  [g4, 'Timber logs stacked for pallet manufacturing'],
  [g5, 'Sawn timber stacked at the Ambica Patterns factory'],
  [g6, 'Forklift loading finished wooden pallets'],
  [g7, 'Freshly built wooden pallet on the factory floor'],
] as const;
const galleryImgs = await Promise.all(gallery.map(async ([src, alt]) => ({ img: await getImage({ src, height: 350, format: 'webp', quality: 72 }), alt })));

const faqs = [
  { q: 'Where is Ambica Patterns located?', a: 'Our factory is at No. 6/7, Hesarghatta Main Road, near Chikkabanavara Railway Station, Bengaluru 560090, Karnataka.' },
  { q: 'Do you make pallets in custom sizes?', a: 'Yes. Send your product size, load weight and handling method and we will propose a design and quote.' },
  { q: 'Are your pallets suitable for export?', a: `Yes. We run a registered ISPM-15 heat-treatment facility (${site.ippc}) and stamp export pallets with the IPPC mark "${site.ippc} HT".` },
  { q: 'Do you make EPAL pallets?', a: 'We do not hold an EPAL licence. We build Euro-size and CP-type pallets to the standard dimensions and layouts, marked with our ISPM-15 stamp instead of EPAL marks.' },
];
---

<Base
  title="Wooden Pallet Manufacturer in Bangalore | Ambica Patterns"
  description={`Ambica Patterns makes wooden pallets in Bengaluru since 2001: Euro-size, CP1-CP9 type, GMA, pinewood and hardwood pallets and pallet collars. ISPM-15 heat treatment ${site.ippc}, ISO 9001.`}
  image={hero.src}
  active="home"
>
  <HeroBuild />

  <div class="divider"><hr /></div>

  <section class="content-section two-column-layout">
    <div class="text-content">
      <h2 data-aos="fade-up">Wooden Pallets Since {site.founded}</h2>
      <p>
        Ambica Patterns India Pvt Ltd has made wooden pallets in Bengaluru since {site.founded}. Every
        pallet is built in our own plant at Chikkabanavara, north Bengaluru: we hold timber stock on site, cut boards and blocks to size,
        assemble each model to its drawing and heat treat export pallets in our registered chamber before they leave the gate. From here,
        close to the Peenya industrial belt, we deliver across Karnataka and the rest of India.
      </p>
      <p>
        Every pallet is built to carry your goods safely and efficiently, from a 1200 × 800 Euro-size pallet for export cartons to a
        1275 × 1275 hardwood pallet for heavy machinery, and we build custom sizes to your drawing.
      </p>
    </div>
    <div class="image-content" data-aos="fade-left">
      <Image src={imgBlocks} alt="Cut timber blocks ready for pallet assembly at Ambica Patterns" widths={[480, 720, 960]} sizes="(max-width: 768px) 90vw, 45vw" loading="lazy" />
    </div>
  </section>

  <div class="divider"><hr /></div>

  <section class="content-section">
    <h2 data-aos="fade-up">Our Product Range</h2>
    <p>{products.length} pallet models in six families.</p>
    <div class="product-range-container range-focus">
      {
        categories.map((c, i) => (
          <ProductCard href={categoryUrl(c.slug)} title={c.name} image={mainImage(productBySlug[c.heroProduct])} text={c.summary} line={c.line} delay={(i % 3) * 200} />
        ))
      }
    </div>
  </section>

  <div class="divider"><hr /></div>

  <section class="content-section lead-in-gallery">
    <h2 data-aos="fade-up">{yearsInBusiness} Years in Pallets</h2>
    <p>
      We started in {site.founded} as a small workshop and grew into a full pallet plant. Many customers have ordered from us for years,
      because every batch matches the one before.
    </p>
  </section>

  <section class="gallery-carousel-section" aria-label="Our factory">
    <div class="gallery-scroller" data-direction="left" data-speed="slow">
      <div class="scroller-inner">
        {galleryImgs.map(({ img, alt }) => <img src={img.src} width={img.attributes.width} height={img.attributes.height} alt={alt} loading="lazy" decoding="async" />)}
        {galleryImgs.map(({ img }) => <img src={img.src} width={img.attributes.width} height={img.attributes.height} alt="" aria-hidden="true" loading="lazy" decoding="async" />)}
      </div>
    </div>
  </section>

  <section class="about-section home-industries">
    <h2 data-aos="fade-up">Industries We Serve</h2>
    <p>We cater to a wide range of industries, providing pallet solutions that meet the specific requirements of each sector.</p>
    <Industries />
  </section>

  <div class="divider"><hr /></div>

  <section class="about-section">
    <h2 data-aos="fade-up">Frequently Asked Questions</h2>
    <Faq items={faqs} />
  </section>
</Base>

<script is:inline>
  // "Our Product Range" on phones: compact rows. The row at the middle of the screen opens up (its pallet
  // grows and moves to the centre, the description appears) and closes again as you scroll on. Layout
  // changes are animated FLIP-style: measure, switch the class, then animate from the old boxes.
  (function () {
    var box = document.querySelector('.range-focus');
    if (!box || !box.animate) return;
    var phone = window.matchMedia('(max-width: 768px)');
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    var cards = [].slice.call(box.querySelectorAll('.product-card'));
    var active = null, busy = false, queued = false;
    var MS = 480, EASE = 'cubic-bezier(0.2, 0.8, 0.2, 1)';

    var parts = function (c) { return [c.querySelector('.product-card-image'), c.querySelector('h3')]; };
    var snap = function (c) {
      var r = c.getBoundingClientRect();
      return { h: r.height, p: parts(c).map(function (el) {
        var q = el.getBoundingClientRect();
        return { x: q.left - r.left, y: q.top - r.top, w: q.width, h: q.height };
      }) };
    };
    var set = function (next) {
      if (next === active) return;
      var touched = [active, next].filter(Boolean);
      var before = touched.map(snap);
      if (active) active.classList.remove('is-focus');
      if (next) next.classList.add('is-focus');
      active = next;
      var anims = [];
      touched.forEach(function (c, i) {
        var a = before[i], b = snap(c);
        anims.push(c.animate([{ height: a.h + 'px' }, { height: b.h + 'px' }], { duration: MS, easing: EASE }));
        parts(c).forEach(function (el, k) {
          var f = a.p[k], l = b.p[k];
          var t = 'translate(' + (f.x - l.x) + 'px,' + (f.y - l.y) + 'px)' + (k === 0 ? ' scale(' + f.w / l.w + ',' + f.h / l.h + ')' : '');
          anims.push(el.animate([{ transform: t, transformOrigin: '0 0' }, { transform: 'none', transformOrigin: '0 0' }], { duration: MS, easing: EASE }));
        });
        var shown = c.querySelectorAll(c.classList.contains('is-focus') ? '.product-card-text' : '.product-card-line, .product-card-arrow');
        [].forEach.call(shown, function (el) {
          anims.push(el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: MS * 0.6, delay: MS * 0.4, easing: 'ease-out', fill: 'backwards' }));
        });
      });
      busy = true;
      Promise.all(anims.map(function (x) { return x.finished; })).catch(function () {}).then(function () { busy = false; check(); });
    };
    var check = function () {
      queued = false;
      if (busy) return;
      if (!phone.matches || calm.matches) {
        if (active) { active.classList.remove('is-focus'); active = null; }
        return;
      }
      var mid = window.innerHeight / 2, pick = active;
      var first = cards[0].getBoundingClientRect(), last = cards[cards.length - 1].getBoundingClientRect();
      if (mid < first.top || mid > last.bottom) pick = null;
      else cards.forEach(function (c) { var r = c.getBoundingClientRect(); if (r.top + 8 <= mid && r.bottom - 8 >= mid) pick = c; });
      set(pick);
    };
    var later = function () { if (!queued) { queued = true; requestAnimationFrame(check); } };
    window.addEventListener('scroll', later, { passive: true });
    window.addEventListener('resize', later);
    check();
  })();
</script>

<script is:inline>
  // Factory gallery strip: fetch the photos shortly before the strip is reached, and only start the
  // motion (from the first photo) once every photo is decoded, so nothing pops in while it moves.
  (function () {
    var strip = document.querySelector('.scroller-inner');
    if (!strip) return;
    var imgs = [].slice.call(strip.querySelectorAll('img'));
    var start = function () {
      imgs.forEach(function (i) { i.loading = 'eager'; });
      Promise.all(imgs.map(function (i) { return i.decode ? i.decode().catch(function () {}) : Promise.resolve(); }))
        .then(function () { strip.classList.add('is-ready'); });
    };
    if (!('IntersectionObserver' in window)) return start();
    var io = new IntersectionObserver(function (es) {
      if (es.some(function (e) { return e.isIntersecting; })) { io.disconnect(); start(); }
    }, { rootMargin: '800px 0px' });
    io.observe(strip);
  })();
</script>

