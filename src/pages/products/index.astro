---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductRow from '../../components/ProductRow.astro';
import JsonLd from '../../components/JsonLd.astro';
import { categories, categoryUrl, products, productsIn, productUrl } from '../../lib/catalog';
import { site } from '../../data/site';

const copy = Object.fromEntries((await getCollection('products')).map((e) => [e.id, e.data.summary]));
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Wooden pallets by Ambica Patterns',
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(productUrl(p), site.url).href, name: p.name })),
};
---

<Base
  title="Wooden Pallets: Euro-Size, CP-Type, GMA, Pinewood & Hardwood"
  description={`${products.length} wooden pallet models made in Bengaluru: Euro-size 1200 × 800, CP1-CP9 type, GMA 48 × 40, pinewood, hardwood and pallet collars. ISPM-15 heat treated.`}
  active="products"
  mainClass="products-main"
>
  <h1 class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Wooden pallets by Ambica Patterns</h1>

  <div class="products-nav-header">
    <div class="products-nav-container" role="tablist" aria-label="Pallet families">
      {
        categories.map((c, i) => (
          <a class={`products-nav-item${i === 0 ? ' active' : ''}`} data-category={i} href={`#${c.slug}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>
            {c.tab}
          </a>
        ))
      }
      <div class="products-nav-indicator"></div>
    </div>
  </div>

  <div class="products-swiper">
    <div class="swiper-wrapper">
      {
        categories.map((c) => (
          <div class="swiper-slide category-slide" id={c.slug} role="tabpanel">
            <div class="category-content">
              <div class="category-header">
                <h2>{c.name}</h2>
                <p class="category-description">{c.summary}</p>
                <p class="category-more"><a href={categoryUrl(c.slug)}>Buying guide and FAQs for {c.name.toLowerCase()}</a></p>
              </div>
              <div class="products-list">
                {productsIn(c.slug).map((p) => (
                  <ProductRow product={p} summary={copy[p.slug]} />
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <JsonLd data={itemList} />
</Base>

<style is:global>
  .category-header h2 { font-family: var(--font-heading); font-size: 3.5rem; color: var(--primary-color); margin-bottom: 1rem; font-weight: normal; }
  .category-more { margin-top: 1rem; }
  .category-more a { font-weight: 600; text-decoration: none; }
  .category-more a:hover { text-decoration: underline; }
  .products-nav-container { max-width: 1100px; }
  a.products-nav-item { text-decoration: none; }
  @media (max-width: 768px) {
    .category-header h2 { font-size: 2.6rem; }
    .products-nav-container { justify-content: flex-start; overflow-x: auto; scrollbar-width: none; padding-bottom: 1rem; margin-bottom: -1rem; }
    .products-nav-container::-webkit-scrollbar { display: none; }
  }
</style>

<script>
  import Swiper from 'swiper';
  import 'swiper/css';

  // Same behaviour as the original products page: tabs + sliding indicator + swipeable categories,
  // the container grows/shrinks to the active category. Plus deep links (#cp-pallets).
  const navItems = [...document.querySelectorAll<HTMLAnchorElement>('.products-nav-item')];
  const indicator = document.querySelector<HTMLElement>('.products-nav-indicator');
  const container = document.querySelector<HTMLElement>('.products-swiper');
  const ids = navItems.map((a) => a.getAttribute('href')!.slice(1));

  function updateIndicator(item?: HTMLElement) {
    if (!indicator || !item) return;
    indicator.style.left = `${item.offsetLeft}px`;
    indicator.style.width = `${item.offsetWidth}px`;
  }
  function updateHeight(sw: Swiper) {
    const content = sw.slides[sw.activeIndex]?.querySelector<HTMLElement>('.category-content');
    if (content && container) container.style.height = `${content.scrollHeight}px`;
  }
  function updateNav(index: number) {
    navItems.forEach((n, i) => {
      n.classList.toggle('active', i === index);
      n.setAttribute('aria-selected', String(i === index));
    });
    const item = navItems[index];
    updateIndicator(item);
    item?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
  }

  const start = Math.max(0, ids.indexOf(location.hash.slice(1)));
  const sw = new Swiper('.products-swiper', {
    speed: 500,
    resistanceRatio: 0.3,
    threshold: 20,
    initialSlide: start,
    on: {
      init(s) {
        updateHeight(s);
        updateNav(s.activeIndex);
      },
      slideChangeTransitionStart(s) {
        updateNav(s.activeIndex);
        updateHeight(s);
        history.replaceState(null, '', `#${ids[s.activeIndex]}`);
      },
    },
  });
  navItems.forEach((item, i) =>
    item.addEventListener('click', (e) => {
      e.preventDefault();
      sw.slideTo(i);
    }),
  );
  window.addEventListener('hashchange', () => {
    const i = ids.indexOf(location.hash.slice(1));
    if (i >= 0) sw.slideTo(i);
  });
  const refresh = () => {
    updateNav(sw.activeIndex);
    updateHeight(sw);
  };
  window.addEventListener('load', refresh);
  window.addEventListener('resize', refresh);
  document.querySelectorAll('.products-swiper img').forEach((img) => img.addEventListener('load', () => updateHeight(sw), { once: true }));
  // 3D viewers change nothing in height, but a late font swap can; re-check once fonts are ready
  document.fonts?.ready.then(() => updateHeight(sw));
</script>
