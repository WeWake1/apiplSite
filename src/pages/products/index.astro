---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductRow from '../../components/ProductRow.astro';
import JsonLd from '../../components/JsonLd.astro';
import { categories, categoryUrl, products, productsIn, productUrl } from '../../lib/catalog';
import { site } from '../../data/site';

const copy = Object.fromEntries((await getCollection('products')).map((e) => [e.id, e.data.summary]));
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Wooden pallets by Ambica Patterns',
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(productUrl(p), site.url).href, name: p.name })),
};
---

<Base
  title="Wooden Pallets: Euro-Size, CP-Type, GMA, Pinewood & Hardwood"
  description={`${products.length} wooden pallet models made in Bengaluru: Euro-size 1200 × 800, CP1-CP9 type, GMA 48 × 40, pinewood, hardwood and pallet collars. ISPM-15 heat treated.`}
  active="products"
  mainClass="products-main"
>
  <h1 class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Wooden pallets by Ambica Patterns</h1>

  <div class="products-nav-header">
    <div class="products-nav-container" role="tablist" aria-label="Pallet families">
      {
        categories.map((c, i) => (
          <a
            class={`products-nav-item${i === 0 ? ' active' : ''}`}
            id={`tab-${c.slug}`}
            href={categoryUrl(c.slug)}
            data-panel={c.slug}
            role="tab"
            aria-controls={c.slug}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {c.tab}
          </a>
        ))
      }
      <div class="products-nav-indicator"></div>
    </div>
  </div>

  {
    categories.map((c, i) => (
      <section class="category-panel" id={c.slug} role="tabpanel" aria-labelledby={`tab-${c.slug}`} hidden={i !== 0}>
        <div class="category-content">
          <div class="category-header">
            <h2>{c.name}</h2>
            <p class="category-description">{c.summary}</p>
            <p class="category-more"><a href={categoryUrl(c.slug)}>Buying guide and FAQs for {c.name.toLowerCase()}</a></p>
          </div>
          <div class="products-list">
            {productsIn(c.slug).map((p) => (
              <ProductRow product={p} summary={copy[p.slug]} />
            ))}
          </div>
        </div>
      </section>
    ))
  }
  <script is:inline>
    // Open the family named in the URL (#cp-pallets) before the first paint, so there is no flash.
    (function () {
      var id = location.hash.slice(1);
      var panel = id && document.getElementById(id);
      if (!panel || !panel.classList.contains('category-panel')) return;
      document.querySelectorAll('.category-panel').forEach(function (p) { p.hidden = p !== panel; });
      document.querySelectorAll('.products-nav-item').forEach(function (t) {
        var on = t.getAttribute('data-panel') === id;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
    })();
  </script>
  <JsonLd data={itemList} />
</Base>

<style is:global>
  .category-header h2 { font-family: var(--font-body); font-weight: 700; font-size: 2.6rem; color: var(--primary-color); margin-bottom: 1rem; }
  .category-more { margin-top: 1rem; }
  .category-more a { font-weight: 600; text-decoration: none; }
  .category-more a:hover { text-decoration: underline; }
  .products-nav-container { max-width: 1100px; }
  a.products-nav-item { text-decoration: none; }
  .category-panel:not([hidden]) { animation: panel-in 0.35s ease-out; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .category-panel:not([hidden]) { animation: none; } }
  @media (max-width: 768px) {
    .category-header h2 { font-size: 2rem; }
    .products-nav-container { justify-content: flex-start; overflow-x: auto; scrollbar-width: none; padding-bottom: 1rem; margin-bottom: -1rem; }
    .products-nav-container::-webkit-scrollbar { display: none; }
  }
</style>

<script>
  // Tabs: only the chosen pallet family is on the page. Each tab links to that family's own page, so
  // without JavaScript it still works; with JavaScript it switches in place and keeps #hash deep links.
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.products-nav-item')];
  const panels = [...document.querySelectorAll<HTMLElement>('.category-panel')];
  const indicator = document.querySelector<HTMLElement>('.products-nav-indicator');
  const nav = document.querySelector<HTMLElement>('.products-nav-header');

  function moveIndicator() {
    const tab = tabs.find((t) => t.classList.contains('active'));
    if (!indicator || !tab) return;
    indicator.style.left = `${tab.offsetLeft}px`;
    indicator.style.width = `${tab.offsetWidth}px`;
  }

  function show(id: string, scroll: boolean) {
    const panel = panels.find((p) => p.id === id);
    if (!panel) return;
    panels.forEach((p) => (p.hidden = p !== panel));
    tabs.forEach((t) => {
      const on = t.dataset.panel === id;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on) t.scrollIntoView({ block: 'nearest', inline: 'center' });
    });
    moveIndicator();
    // back to the top of the list, just under the sticky tab bar, if the reader had scrolled down
    if (scroll && nav && window.scrollY > panel.offsetTop - nav.offsetHeight) window.scrollTo({ top: panel.offsetTop - nav.offsetHeight });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      show(tab.dataset.panel!, true);
      history.replaceState(null, '', `#${tab.dataset.panel}`);
    });
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = tabs[(i + step + tabs.length) % tabs.length];
      next.focus();
      next.click();
    });
  });
  window.addEventListener('hashchange', () => show(location.hash.slice(1), true));
  window.addEventListener('resize', moveIndicator);
  document.fonts?.ready.then(moveIndicator);
  moveIndicator();
</script>
